{
  "name": "iztro",
  "version": "2.5.8",
  "description": "轻量级紫微斗数星盘生成库。可以通过出生年月日获取到紫微斗数星盘信息、生肖、星座等信息。This is a lightweight kit for generating astrolabes for Zi Wei Dou Shu (The Purple Star Astrology), an ancient Chinese astrology. It allows you to obtain your horoscope and personality analysis.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/umd/iztro.min.global.js",
  "jsdelivr": "./dist/umd/iztro.min.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.cts",
      "require": "./dist/server/index.cjs"
    }
  },
  "bin": {
    "iztro-grpc": "./dist/server/index.cjs"
  },
  "scripts": {
    "build": "tsup",
    "dev:server": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm lint && pnpm build"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SylarLong/iztro.git"
  },
  "keywords": [
    "紫微斗數",
    "紫微斗数",
    "ziweidoushu",
    "astrology",
    "horoscope",
    "ephemeris",
    "zodiac",
    "sign",
    "grpc"
  ],
  "author": "SylarLong",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SylarLong/iztro/issues",
    "email": "sylarlong@gmail.com"
  },
  "homepage": "https://iztro.com",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.10.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@grpc/grpc-js": "^1.11.1",
    "@weigh-ai/proto": "file:../../G-project/weigh-ai-proto",
    "dayjs": "^1.11.10",
    "i18next": "^23.5.1",
    "lunar-lite": "^0.2.8",
    "lunar-typescript": "^1.7.8"
  }
}
